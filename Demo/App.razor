<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="@typeof(DemoLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found · ColorZXing.Net</PageTitle>
        <LayoutView Layout="@typeof(DemoLayout)">
            <main class="not-found"><h1>Page not found</h1><a href="./">Return to the demo</a></main>
        </LayoutView>
    </NotFound>
</Router>
