<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ColorZXing.Net</PackageId>
    <Authors>Hainan.Zhao</Authors>
    <Product>ColorZXing.Net</Product>
    <Company></Company>
    <Description>A colorful QR generator and decoder based on ZXing.Net. You can generate QR code using all RGB channels or only Monotone colors.</Description>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageProjectUrl>https://github.com/HainanZhao/ColorZXing.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HainanZhao/ColorZXing.Net</RepositoryUrl>
    <PackageTags>Color QR Code</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.2.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>Breaking changes and performance improvements
* Rebuilt pixel conversion: removed per-byte Marshal P/Invoke, bitmap bits now unlocked in try/finally (fixes memory leak)
* SIMD (Ssse3) color deinterleave with pointer fallback, ~2x faster decode
* TargetFramework is now net8.0 only (no more netstandard2.0/net45)
* Updated dependencies: ZXing.Net 0.16.11, System.Drawing.Common 4.7.3 (GHSA-rxg9 security fix)
* Decoder now preserves the original line endings of the encoded payload</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Images\icon.jpg">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common">
      <Version>4.7.3</Version>
    </PackageReference>
  </ItemGroup>

</Project>
