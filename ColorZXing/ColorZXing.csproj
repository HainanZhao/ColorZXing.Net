<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ColorZXing.Net</PackageId>
    <Authors>Hainan.Zhao</Authors>
    <Product>ColorZXing.Net</Product>
    <Company></Company>
    <Description>A colorful QR generator and decoder based on ZXing.Net. You can generate QR code using all RGB channels or only Monotone colors.</Description>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageProjectUrl>https://github.com/HainanZhao/ColorZXing.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HainanZhao/ColorZXing.Net</RepositoryUrl>
    <PackageTags>Color QR Code</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.4.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>Adds optional ColorZXingRGB compression overloads and the true ColorZXingHighDensity 64-color format, which multiplexes six QR layers across four calibrated intensity levels per RGB channel. Includes versioned framing, CRC-32 validation, Bitmap/RGBA APIs, browser demo integration, tests, and benchmarks.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Images\icon.jpg" Pack="True" PackagePath="" />
    <None Include="..\README.md" Pack="True" PackagePath="" />
    <None Include="..\PERFORMANCE.md" Pack="True" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common">
      <Version>4.7.3</Version>
    </PackageReference>
  </ItemGroup>

</Project>
