<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ColorZXing.Net</PackageId>
    <Authors>Hainan.Zhao</Authors>
    <Product>ColorZXing.Net</Product>
    <Company></Company>
    <Description>A colorful QR generator and decoder based on ZXing.Net. You can generate QR code using all RGB channels or only Monotone colors.</Description>
    <PackageIcon>colorzxing-zebra.png</PackageIcon>
    <PackageProjectUrl>https://github.com/HainanZhao/ColorZXing.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HainanZhao/ColorZXing.Net</RepositoryUrl>
    <PackageTags>Color QR Code</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.4.3</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>Adds explicit compressed/uncompressed ColorZXingHighDensity overloads and separate demo selections, with a fair long JSON sample sized to fit every QR mode.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Images\colorzxing-zebra.png" Pack="True" PackagePath="" />
    <None Include="..\README.md" Pack="True" PackagePath="" />
    <None Include="..\PERFORMANCE.md" Pack="True" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common">
      <Version>4.7.3</Version>
    </PackageReference>
  </ItemGroup>

</Project>
